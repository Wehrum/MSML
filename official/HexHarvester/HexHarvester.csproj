<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Hex Harvester: a new vehicle sold in the garage, built on the MSML vehicle API. -->
  <PropertyGroup>
    <IsModProject>true</IsModProject>
    <UseMsmlApi>true</UseMsmlApi>
    <AssemblyName>MSML.HexHarvester</AssemblyName>
    <RootNamespace>MSML.HexHarvester</RootNamespace>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine-independent model code, shared with tools\ModelPreview so previews match the game exactly. -->
    <Compile Include="..\..\shared\ModelKit\*.cs" Link="ModelKit\%(Filename)%(Extension)" />
    <Compile Include="..\..\shared\ModelKit.Unity\*.cs" Link="ModelKit\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
