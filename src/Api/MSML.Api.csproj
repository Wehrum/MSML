<Project Sdk="Microsoft.NET.Sdk">
  <!-- MSML.Api.dll: the public modding API. Ships with the loader (BepInEx\plugins\MSML.Api); mods reference it. -->
  <PropertyGroup>
    <IsModProject>true</IsModProject>
    <ModKind>LoaderPlugin</ModKind>
    <AssemblyName>MSML.Api</AssemblyName>
    <RootNamespace>MSML</RootNamespace>
    <Version>0.7.0</Version>
    <!-- Fixed, so mods built against the API don't change (and re-release) every time the API's version does.
         The real version is in the file/product version and Msml.ApiVersion. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MoonSweepMods.ModLoader" />
  </ItemGroup>
</Project>
