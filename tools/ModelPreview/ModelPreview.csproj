<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline renderer for ModelKit designs. Run: tools\preview-model.ps1 [DesignId] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MoonSweepMods.ModelPreview</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <Compile Include="..\..\shared\ModelKit\*.cs" Link="ModelKit\%(Filename)%(Extension)" />
    <!-- Every design in the repo: examples/<Mod>/Design/*.cs -->
    <Compile Include="..\..\examples\*\Design\*.cs" Link="Designs\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
